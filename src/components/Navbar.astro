---
// Navbar — satu menu per halaman standar (link asli, tanpa duplikat)
const links = [
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
  { label: "Privacy", href: "/privacy" },
  { label: "Security", href: "/security" },
];
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-neutral-100">
  <nav class="mx-auto flex h-[68px] max-w-[1200px] items-center justify-between px-6 lg:px-8">
    <!-- Logo kiri -->
    <a href="/" class="flex items-center gap-2.5 shrink-0" aria-label="ElephantLabs home">
      <img src="/elephantlabslogo.png" alt="ElephantLabs logo" class="h-9 w-auto" />
      <span class="leading-none">
        <span class="block text-[19px] font-bold tracking-[-0.02em] text-black">ElephantLabs</span>
        <span class="mt-1 block text-[10.5px] font-medium tracking-wide text-neutral-500">a Koncoweb Product</span>
      </span>
    </a>

    <!-- Menu tengah (desktop) -->
    <ul class="hidden lg:flex items-center gap-7">
      {links.map((item) => (
        <li>
          <a
            href={item.href}
            class="text-[14.5px] font-medium text-neutral-600 transition-colors hover:text-black"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Aksi kanan -->
    <div class="flex items-center gap-2 sm:gap-3">
      <span id="nav-user-wrap" class="hidden items-center gap-2">
        <span id="nav-user-email" class="hidden max-w-[160px] truncate text-[14px] font-medium text-neutral-700 sm:inline"></span>
        <button
          id="nav-logout"
          type="button"
          class="rounded-full px-4 py-2 text-[14.5px] font-medium text-neutral-800 transition-colors hover:text-black"
        >
          Log out
        </button>
      </span>
      <span id="nav-guest-wrap" class="flex items-center gap-2 sm:gap-3">
        <a
          href="/login"
          class="hidden sm:inline-flex rounded-full px-4 py-2 text-[14.5px] font-medium text-neutral-800 transition-colors hover:text-black"
        >
          Log in
        </a>
        <a
          href="/login?mode=signup"
          class="inline-flex items-center justify-center rounded-full bg-black px-[20px] py-[9px] text-[14.5px] font-semibold text-white transition-all hover:bg-neutral-800 active:scale-[0.98]"
        >
          Sign up
        </a>
      </span>
      <!-- Hamburger mobile -->
      <button
        type="button"
        class="lg:hidden grid h-10 w-10 place-items-center rounded-full hover:bg-neutral-100"
        aria-label="Open menu"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M3 5.5h14M3 10h14M3 14.5h14" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Menu mobile statis (simple, tanpa JS) -->
  <div class="lg:hidden border-t border-neutral-100 px-6 py-3 hidden">
    <ul class="flex flex-col gap-1">
      {links.map((item) => (
        <li>
          <a href={item.href} class="block rounded-lg px-2 py-2 text-[15px] font-medium text-neutral-700 hover:bg-neutral-50 hover:text-black">
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  import { authClient, getSessionUser } from '../lib/auth';

  const guestWrap = document.getElementById('nav-guest-wrap');
  const userWrap = document.getElementById('nav-user-wrap');
  const userEmail = document.getElementById('nav-user-email');
  const logoutBtn = document.getElementById('nav-logout');

  getSessionUser().then((u) => {
    if (!u) return;
    guestWrap?.classList.add('hidden');
    guestWrap?.classList.remove('flex');
    userWrap?.classList.remove('hidden');
    userWrap?.classList.add('flex');
    if (userEmail) userEmail.textContent = u.email;
  });

  logoutBtn?.addEventListener('click', async () => {
    await authClient.signOut();
    window.location.reload();
  });
</script>
