---
// Navbar — statis, tanpa fetch/API
const links = ["Products", "Solutions", "Customers", "Resources", "Enterprise", "Pricing"];
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-neutral-100">
  <nav class="mx-auto flex h-[68px] max-w-[1200px] items-center justify-between px-6 lg:px-8">
    <!-- Logo kiri -->
    <a href="/" class="flex items-center gap-2 shrink-0" aria-label="ElephantLabs home">
      <!-- Ikon gajah hitam minimalis -->
      <span class="grid h-7 w-7 place-items-center rounded-[7px] bg-black">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="white" aria-hidden="true">
          <path d="M17.2 3.5c-1.1 0-2 .3-2.7.8C13.3 3.5 11.4 3 9.3 3 5.6 3 2.8 5.7 2.8 9.2c0 1.5.5 2.8 1.4 3.9-.1.4-.2.9-.2 1.4 0 1.7 1 3 2.4 3.5.3.6 1 1 1.8 1 1.2 0 2.1-.9 2.1-2 0-.3 0-.5-.1-.8l1.1-.6c.4 1 1.2 1.7 2.2 1.9l.7 2.1c.1.4.5.6.9.5.4-.1.6-.5.5-.9l-.6-1.9c1-.3 1.8-1.1 2-2.2l1.6-7.1c.2-1.1-.4-3.5-1.4-4.5ZM8.2 16.9c-.6 0-1-.4-1-1s.4-1 1-1 1 .4 1 1-.4 1-1 1Zm4.1-8.2c-.5 0-.9-.4-.9-.9s.4-.9.9-.9.9.4.9.9-.4.9-.9.9Z"/>
        </svg>
      </span>
      <span class="text-[19px] font-bold tracking-[-0.02em] text-black">ElephantLabs</span>
    </a>

    <!-- Menu tengah (desktop) -->
    <ul class="hidden lg:flex items-center gap-7">
      {links.map((item) => (
        <li>
          <a
            href="#"
            class="text-[14.5px] font-medium text-neutral-600 transition-colors hover:text-black"
          >
            {item}
          </a>
        </li>
      ))}
    </ul>

    <!-- Aksi kanan -->
    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href="#"
        class="hidden sm:inline-flex rounded-full px-4 py-2 text-[14.5px] font-medium text-neutral-800 transition-colors hover:text-black"
      >
        Log in
      </a>
      <a
        href="#"
        class="inline-flex items-center justify-center rounded-full bg-black px-[20px] py-[9px] text-[14.5px] font-semibold text-white transition-all hover:bg-neutral-800 active:scale-[0.98]"
      >
        Sign up
      </a>
      <!-- Hamburger mobile -->
      <button
        type="button"
        class="lg:hidden grid h-10 w-10 place-items-center rounded-full hover:bg-neutral-100"
        aria-label="Open menu"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M3 5.5h14M3 10h14M3 14.5h14" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Menu mobile statis (simple, tanpa JS) -->
  <div class="lg:hidden border-t border-neutral-100 px-6 py-3 hidden">
    <ul class="flex flex-col gap-1">
      {links.map((item) => (
        <li>
          <a href="#" class="block rounded-lg px-2 py-2 text-[15px] font-medium text-neutral-700 hover:bg-neutral-50 hover:text-black">
            {item}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>
