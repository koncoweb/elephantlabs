---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import SeoSections from '../components/SeoSections.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import { faqs } from '../data/faq';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};
---

<Layout
  title="TTS Gratis — Ubah Teks Jadi Suara Online | ElephantLabs"
  description="ElephantLabs adalah tool teks to speech gratis. Converter teks jadi suara & teks ke suara MP3 dengan narator AI gratis, tanpa daftar."
  schema={[faqSchema]}
>
  <Navbar />
  <main>
    <Hero />
    <SeoSections />
    <Faq />
  </main>
  <Footer />
</Layout>
